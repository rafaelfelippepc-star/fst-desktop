{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "FST Beta",
  "version": "1.0.38",
  "identifier": "com.fst.desktop",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FST Beta",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": "default-src 'self' https: http: 'unsafe-eval' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: http: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
